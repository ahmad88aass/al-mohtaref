import React, { useState } from 'react';
import { Headphones, X, MessageCircle, Send, Instagram, Twitter } from 'lucide-react';

export const SupportWidget: React.FC = () => {
  const [isOpen, setIsOpen] = useState(false);

  const channels = [
    {
      name: 'Twitter (X)',
      icon: <Twitter className="w-5 h-5 text-white" />,
      url: 'https://x.com/abo123hmed',
      bg: 'bg-black hover:bg-neutral-800 border border-neutral-700 shadow-md',
    },
    {
      name: 'Instagram',
      icon: <Instagram className="w-5 h-5 text-white" />,
      url: 'https://instagram.com/a.j._7',
      bg: 'bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 hover:opacity-90 shadow-md shadow-pink-500/25',
    },
    {
      name: 'Telegram',
      icon: <Send className="w-5 h-5 text-white -translate-x-0.5" />,
      url: 'https://t.me/ahmad88_a',
      bg: 'bg-[#229ED9] hover:bg-[#1e8ec3] shadow-md shadow-sky-500/25',
    },
    {
      name: 'WhatsApp',
      icon: <MessageCircle className="w-5 h-5 text-white" />,
      url: 'https://wa.me/963984335910',
      bg: 'bg-[#25D366] hover:bg-[#20ba59] shadow-md shadow-emerald-500/25',
    },
  ];

  const menuClassName =
    'flex flex-col-reverse items-center gap-3 mb-3 transition-all duration-300 ' +
    (isOpen
      ? 'opacity-100 scale-100 translate-y-0 pointer-events-auto'
      : 'opacity-0 scale-75 translate-y-6 pointer-events-none');

  return (
    <div className="fixed bottom-20 left-4 sm:left-6 z-50 flex flex-col items-center">
      {/* القائمة المنبثقة للأيقونات */}
      <div className={menuClassName}>
        {channels.map((ch, idx) => (
          <a
            key={idx}
            href={ch.url}
            target="_blank"
            rel="noopener noreferrer"
            title={ch.name}
            className={'w-11 h-11 rounded-full flex items-center justify-center transition-transform duration-200 hover:scale-110 active:scale-95 ' + ch.bg}
          >
            {ch.icon}
          </a>
        ))}
      </div>

      {/* الزر الرئيسي للدعم الفني */}
      <button
        onClick={() => setIsOpen(!isOpen)}
        className="w-13 h-13 rounded-2xl bg-gradient-to-tr from-amber-500 to-yellow-400 text-slate-950 p-3.5 shadow-lg shadow-amber-500/30 flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95"
        aria-label="الدعم الفني"
      >
        {isOpen ? (
          <X className="w-6 h-6 stroke-[2.5]" />
        ) : (
          <Headphones className="w-6 h-6 stroke-[2.5]" />
        )}
      </button>
    </div>
  );
};

